# Copy to .env for local reference. Do not commit real values.
# Edge Functions read the names below with Deno.env.get. Set them as
# Supabase Edge Function secrets, not in the Vite bundle.
# The browser client does not import the VITE_* names; the project URL
# and anon key are written in src/integrations/supabase/client.ts.
# Use the anon/publishable key there, never the service-role key.

# Browser project values (not imported by the Vite client).
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Data sync, Stripe, insights, and the webhook.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# create-stripe-checkout, create-stripe-portal, stripe-webhook
STRIPE_SECRET_KEY=
# stripe-webhook
STRIPE_WEBHOOK_SECRET=

# generate-match-insights
OPENAI_API_KEY=

# initial-data-sync, test-api-connection, sync-football-data, generate-match-insights
RAPIDAPI_KEY=

# send-contact-email
RESEND_API_KEY=
